---
// Main blog index page - Direct to blog (no separate homepage)
import MainLayout from '../layouts/MainLayout.astro';
import BlogCard from '../components/BlogCard.astro';

// Get all blog posts from the content collection
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Sort posts by date - most recent first
const sortedPosts = allPosts.sort((a, b) =>
  new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Get category from URL params
const category = Astro.url.searchParams.get('cat');

// Filter posts by category if specified
const filteredPosts = category && category !== 'all'
  ? sortedPosts.filter(post => post.data.category?.toLowerCase() === category.toLowerCase())
  : sortedPosts;
---

<MainLayout title="Accueil" currentCategory={category || 'all'}>
  <div class="blog-container">
    <div class="blog-grid">
      {filteredPosts.map((post) => (
        <BlogCard
          slug={post.slug}
          title={post.data.title}
          excerpt={post.data.description}
          pubDate={post.data.pubDate}
          category={post.data.category}
          image={post.data.image}
        />
      ))}
    </div>

    <!-- Load More Button -->
    <div class="load-more">
      <button class="load-btn">Charger plus d'articles</button>
    </div>
  </div>

  <!-- Ribbon Separator -->
  <div class="ribbon" style="margin: 4rem 0 0 0;">
    <div class="ribbon-prune"></div>
    <div class="ribbon-framboise"></div>
    <div class="ribbon-bleu"></div>
    <div class="ribbon-vert"></div>
  </div>
</MainLayout>

<style>
  .blog-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .load-more {
    text-align: center;
    padding: 2rem;
  }

  .load-btn {
    background: white;
    border: 2px solid #C23068;
    color: #C23068;
    padding: 0.9rem 2.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 2px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Lora', serif;
  }

  .load-btn:hover {
    background: #C23068;
    color: white;
  }

  @media (max-width: 768px) {
    .blog-container {
      padding: 1.5rem 1rem;
    }

    .blog-grid {
      gap: 2rem;
    }
  }
</style>
