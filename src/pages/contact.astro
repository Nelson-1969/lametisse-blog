---
// Contact page
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact" currentCategory="contact">
  <div class="container modal-content">
    <h1>Nous Contacter</h1>

    <p>
      Vous avez une question, une proposition ou vous souhaitez simplement échanger ? Nadine sera ravi de vous entendre !
    </p>

    <h2>Coordonnées</h2>

    <div class="contact-info">
      <div class="info-item">
        <strong>Email</strong>
        <p>
          <a href="mailto:nadine@lametisseadit.com">nadine@lametisseadit.com</a>
        </p>
      </div>

      <div class="info-item">
        <strong>Instagram</strong>
        <p>
          <a href="https://instagram.com/lametisseadit" target="_blank">@lametisseadit</a>
        </p>
      </div>

      <div class="info-item">
        <strong>Collaborations & Partenariats</strong>
        <p>
          <a href="mailto:collaborations@lametisseadit.com">collaborations@lametisseadit.com</a>
        </p>
      </div>
    </div>

    <h2>Formulaire de Contact</h2>

    <form class="contact-form">
      <div class="form-group">
        <label for="name">Nom</label>
        <input type="text" id="name" name="name" required />
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required />
      </div>

      <div class="form-group">
        <label for="subject">Sujet</label>
        <input type="text" id="subject" name="subject" required />
      </div>

      <div class="form-group">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>

      <button type="submit" class="submit-btn">Envoyer</button>
    </form>
  </div>

  <!-- Ribbon Separator -->
  <div class="ribbon" style="margin: 4rem 0 0 0;">
    <div class="ribbon-prune"></div>
    <div class="ribbon-framboise"></div>
    <div class="ribbon-bleu"></div>
    <div class="ribbon-vert"></div>
  </div>
</MainLayout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
  }

  .modal-content h1 {
    font-size: 2.2rem;
    color: #82254F;
    margin-bottom: 1.5rem;
  }

  .modal-content h2 {
    font-size: 1.5rem;
    color: #82254F;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .modal-content p {
    font-size: 1rem;
    color: #666;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }

  .contact-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .info-item {
    background: #F8F8F8;
    padding: 1.5rem;
    border-radius: 2px;
  }

  .info-item strong {
    display: block;
    color: #82254F;
    font-weight: 700;
    margin-bottom: 0.8rem;
  }

  .info-item p {
    margin: 0;
    font-size: 0.95rem;
  }

  .info-item a {
    color: #C23068;
    text-decoration: none;
    font-weight: 600;
  }

  .info-item a:hover {
    color: #82254F;
  }

  /* Form Styles */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .form-group label {
    font-weight: 600;
    color: #82254F;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .form-group input,
  .form-group textarea {
    padding: 0.8rem;
    border: 1px solid #ddd;
    border-radius: 2px;
    font-family: 'Lora', serif;
    font-size: 0.95rem;
    transition: border-color 0.3s ease;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: #C23068;
  }

  .submit-btn {
    background: #C23068;
    color: white;
    padding: 0.9rem 2rem;
    border: none;
    border-radius: 2px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: 'Lora', serif;
  }

  .submit-btn:hover {
    background: #82254F;
  }

  @media (max-width: 768px) {
    .container {
      padding: 1.5rem 1rem;
    }

    .modal-content h1 {
      font-size: 1.8rem;
    }

    .modal-content h2 {
      font-size: 1.3rem;
    }

    .contact-info {
      grid-template-columns: 1fr;
    }
  }
</style>
