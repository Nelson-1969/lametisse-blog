---
// Labutik - Shop page with product presentation
import MainLayout from '../layouts/MainLayout.astro';

const products = [
  {
    id: 1,
    title: 'Carnet de Voyage',
    price: '28€',
    description: 'Carnet à couverture premium pour vos aventures',
    image: '📔',
  },
  {
    id: 2,
    title: 'Foulard Soieries',
    price: '45€',
    description: 'Foulard en soie imprimé aux couleurs de LMAD',
    image: '🧵',
  },
  {
    id: 3,
    title: 'Portfolio Photo',
    price: '35€',
    description: 'Portfolio de 20 photos sélectionnées du blog',
    image: '📸',
  },
  {
    id: 4,
    title: 'Coffret Thé Exotique',
    price: '32€',
    description: 'Sélection de thés des destinations voyages',
    image: '☕',
  },
];
---

<MainLayout title="Labutik" currentCategory="labutik">
  <div class="container">
    <h1 style="font-size: 2.2rem; color: #82254F; margin-bottom: 2rem;">
      Labutik — Objets de Voyage
    </h1>

    <div class="shop-grid">
      {products.map((product) => (
        <article class="product-card">
          <div class="product-image">{product.image}</div>
          <h3 class="product-title">{product.title}</h3>
          <p class="product-description">{product.description}</p>
          <p class="product-price">{product.price}</p>
          <a href="#" class="product-link">Acheter →</a>
        </article>
      ))}
    </div>

    <!-- Ribbon Separator -->
    <div class="ribbon" style="margin: 4rem 0 0 0;">
      <div class="ribbon-prune"></div>
      <div class="ribbon-framboise"></div>
      <div class="ribbon-bleu"></div>
      <div class="ribbon-vert"></div>
    </div>
  </div>
</MainLayout>

<style>
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
  }

  .shop-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-bottom: 2rem;
  }

  .product-card {
    text-align: center;
    transition: all 0.3s ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
  }

  .product-image {
    width: 100%;
    height: 300px;
    background: linear-gradient(135deg, #C23068, #82254F);
    border-radius: 2px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    color: rgba(255, 255, 255, 0.3);
    margin-bottom: 1.2rem;
  }

  .product-title {
    font-size: 1.3rem;
    color: #82254F;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .product-description {
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .product-price {
    font-size: 1rem;
    color: #C23068;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .product-link {
    background: #C23068;
    color: white;
    padding: 0.7rem 1.5rem;
    text-decoration: none;
    border-radius: 2px;
    display: inline-block;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.3s ease;
  }

  .product-link:hover {
    background: #82254F;
  }

  @media (max-width: 768px) {
    .container {
      padding: 1.5rem 1rem;
    }

    .shop-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .product-image {
      height: 250px;
      font-size: 2rem;
    }
  }
</style>
