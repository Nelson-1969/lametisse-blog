---
import Header from '../components/Header.astro';
import Navigation from '../components/Navigation.astro';
interface Props {
  title?: string;
  currentCategory?: string;
}
const { title = 'La Metisse a Dit', currentCategory = 'all' } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Lora:wght@400;600;700&display=swap" rel="stylesheet" />
    <style is:global>
      :root { --color-prune: #82254F; --color-framboise: #C23068; --color-bleu-lagon: #5BADC8; --color-vert-anis: #D3D96A; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: 'Lora', serif; line-height: 1.6; color: #333; }
      h1, h2, h3 { color: var(--color-prune); }
      .ribbon { display: flex; height: 12px; }
      .ribbon-prune { flex: 1; background: var(--color-prune); }
      .ribbon-framboise { flex: 1; background: var(--color-framboise); }
      .ribbon-bleu { flex: 1; background: var(--color-bleu-lagon); }
      .ribbon-vert { flex: 1; background: var(--color-vert-anis); }
    </style>
  </head>
  <body>
    <Header />
    <Navigation currentCategory={currentCategory} />
    <slot />
  </body>
</html>
