---
// Header component with sticky logo
---

<header class="header">
  <div class="logo">
    <a href="/">
      <span class="logo-main">LA METISSE</span>
      <span class="logo-accent">à dit</span>
    </a>
  </div>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 2rem;
    border-bottom: 1px solid #e0e0e0;
    background: var(--color-white);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .logo a {
    display: flex;
    gap: 0.3rem;
    align-items: center;
    text-decoration: none;
  }

  .logo-main {
    font-size: 1.3rem;
    font-weight: 700;
    color: #82254F;
    letter-spacing: 0.08em;
  }

  .logo-accent {
    font-family: 'Caveat', cursive;
    font-size: 1rem;
    color: #C23068;
  }

  @media (max-width: 768px) {
    .header {
      padding: 1rem;
    }

    .logo-main {
      font-size: 1.1rem;
    }
  }
</style>
