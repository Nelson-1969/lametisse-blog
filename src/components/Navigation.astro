---
// Navigation tabs - sticky tabs for filtering
interface Props {
  currentCategory?: string;
}

const { currentCategory = 'all' } = Astro.props;

const tabs = [
  { label: 'Tous', value: 'all', href: '/' },
  { label: 'Voyages', value: 'voyages', href: '/?cat=voyages' },
  { label: 'Rencontres', value: 'rencontres', href: '/?cat=rencontres' },
  { label: 'Découvertes', value: 'decouvertes', href: '/?cat=decouvertes' },
  { label: 'À Propos', value: 'apropos', href: '/apropos' },
  { label: 'Contact', value: 'contact', href: '/contact' },
  { label: 'Labutik', value: 'labutik', href: '/labutik' },
];
---

<nav class="tabs-container">
  <ul class="tabs">
    {tabs.map((tab) => (
      <li>
        <a
          href={tab.href}
          class={`tab ${currentCategory === tab.value ? 'active' : ''}`}
        >
          {tab.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .tabs-container {
    position: sticky;
    top: 60px;
    background: #fff;
    border-bottom: 1px solid #e0e0e0;
    z-index: 99;
    padding: 0 2rem;
  }

  .tabs {
    display: flex;
    gap: 2rem;
    list-style: none;
    overflow-x: auto;
    margin: 0;
    padding: 0;
  }

  .tab {
    padding: 1rem 0;
    font-size: 0.9rem;
    font-weight: 500;
    color: #999;
    text-decoration: none;
    border-bottom: 3px solid transparent;
    transition: all 0.3s ease;
    white-space: nowrap;
    display: block;
  }

  .tab:hover {
    color: #C23068;
  }

  .tab.active {
    color: #82254F;
    border-bottom-color: #C23068;
  }

  @media (max-width: 768px) {
    .tabs-container {
      padding: 0 1rem;
    }

    .tabs {
      gap: 1rem;
    }

    .tab {
      font-size: 0.8rem;
      padding: 0.8rem 0;
    }
  }
</style>
