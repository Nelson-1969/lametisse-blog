---
// BlogCard component - photo-first design for articles
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  pubDate: Date;
  category?: string;
  image?: string;
}

const { slug, title, excerpt, pubDate, category = 'Voyage', image } = Astro.props;

// Format date to French locale
const formattedDate = new Intl.DateTimeFormat('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(pubDate);
---

<article class="article-item">
  <div class="article-image">
    {image ? (
      <img src={image} alt={title} />
    ) : (
      <div class="image-placeholder">📸</div>
    )}
  </div>

  <div class="article-content">
    <div class="article-meta">
      <span class="article-date">{formattedDate}</span>
      {category && <span class="article-category">{category}</span>}
    </div>

    <h2 class="article-title">
      <a href={`/blog/${slug}`}>{title}</a>
    </h2>

    <p class="article-excerpt">{excerpt}</p>

    <a href={`/blog/${slug}`} class="article-link">
      Lire la suite →
    </a>
  </div>
</article>

<style>
  .article-item {
    overflow: hidden;
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .article-item:hover {
    opacity: 0.95;
  }

  .article-image {
    width: 100%;
    height: 350px;
    background: linear-gradient(135deg, #5BADC8, #D3D96A);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 4rem;
    color: rgba(255, 255, 255, 0.3);
    overflow: hidden;
  }

  .article-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-placeholder {
    font-size: 4rem;
  }

  .article-content {
    padding: 1.8rem 0;
  }

  .article-meta {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    margin-bottom: 0.8rem;
  }

  .article-date {
    font-variant: small-caps;
    font-size: 0.75rem;
    color: #999;
    text-transform: lowercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .article-category {
    font-size: 0.75rem;
    color: #C23068;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .article-title {
    font-size: 2.2rem;
    color: #82254F;
    margin-bottom: 0.8rem;
    line-height: 1.2;
    font-weight: 700;
  }

  .article-title a {
    color: #82254F;
    text-decoration: none;
    transition: 0.3s ease;
  }

  .article-title a:hover {
    color: #C23068;
  }

  .article-excerpt {
    font-size: 1rem;
    color: #666;
    line-height: 1.5;
    margin-bottom: 1rem;
    font-style: italic;
  }

  .article-link {
    color: #C23068;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    display: inline-block;
    transition: 0.3s ease;
  }

  .article-link:hover {
    color: #82254F;
  }

  @media (max-width: 768px) {
    .article-image {
      height: 250px;
      font-size: 2.5rem;
    }

    .article-title {
      font-size: 1.5rem;
    }

    .article-excerpt {
      font-size: 0.9rem;
    }
  }
</style>
